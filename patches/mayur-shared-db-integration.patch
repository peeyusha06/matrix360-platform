+    assert client.patch(f"/api/v1/leads/{lead_id}", headers=ADMIN, json={"stage": "won_big"}).status_code == 422
+    assert client.patch(f"/api/v1/leads/{lead_id}", headers=ADMIN, json={"lead_type": "x"}).status_code == 422
+
+
+def test_contacts_are_recorded_once_per_message_id(client):
+    lead_id = make_lead(client)
+    msg = {"channel": "whatsapp", "direction": "outbound", "status": "sent", "message_id": "wamid.1"}
+    assert client.post(f"/api/v1/leads/{lead_id}/contacts", headers=ADMIN, json=msg).status_code == 201
+    client.post(f"/api/v1/leads/{lead_id}/contacts", headers=ADMIN, json=msg)  # retry
+    assert len(client.get(f"/api/v1/leads/{lead_id}/contacts", headers=ADMIN).json()) == 1
+
