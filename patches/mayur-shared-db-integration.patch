+          --hot:#a3392d; --warm:#9a6400; --cold:#36577a; --ok:#1f7a4d; }
+  @media (prefers-color-scheme: dark) { :root { --bg:#0f161c; --card:#16212a; --ink:#e6edf1; --muted:#9aabb6; --line:#2a3843;
