+def test_visit_schedule_moves_stage_and_reminders_are_due_once(client):
+    lead_id = make_lead(client)
+    visit = client.post(f"/api/v1/leads/{lead_id}/site-visits", headers=ADMIN, json={"requested_by": "chat"}).json()
+    at = datetime.now(timezone.utc) + timedelta(hours=20)
+    r = client.patch(f"/api/v1/site-visits/{visit['id']}", headers=ADMIN,
+                     json={"status": "scheduled", "scheduled_at": at.isoformat()})
+    assert r.status_code == 200
+    assert client.get(f"/api/v1/leads/{lead_id}", headers=ADMIN).json()["stage"] == "visit_booked"
+
+    due = client.get("/api/v1/reminders/due", headers=ADMIN).json()
+    assert [d["kind"] for d in due] == ["24h"]
+    client.post(f"/api/v1/leads/{lead_id}/contacts", headers=ADMIN,
+                json={"channel": "whatsapp", "status": "sent", "message_id": due[0]["message_id"]})
+    assert client.get("/api/v1/reminders/due", headers=ADMIN).json() == []
+    two_hours_before = (at - timedelta(minutes=90)).isoformat()
+    assert [d["kind"] for d in client.get("/api/v1/reminders/due", headers=ADMIN, params={"now": two_hours_before}).json()] == ["2h"]
+
+    client.patch(f"/api/v1/site-visits/{visit['id']}", headers=ADMIN, json={"status": "cancelled"})
+    assert client.get(f"/api/v1/leads/{lead_id}", headers=ADMIN).json()["stage"] == "visit_cancelled"
+    assert client.get("/api/v1/reminders/due", headers=ADMIN).json() == []
+
