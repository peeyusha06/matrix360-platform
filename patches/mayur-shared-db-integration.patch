+
+@pytest.fixture
+def client(tmp_path):
+    settings = Settings(database_url=f"sqlite:///{(tmp_path / 'p.db').as_posix()}", admin_api_key="test-secret",
+                        ai_provider="demo", integration_api_key="tool-secret")
+    return TestClient(create_app(settings=settings))
+
+
+def make_lead(client, **over):
+    body = {"client": "Shree Heights", "property_type": "flats", "lead_type": "buyer", "source": "landing_page",
+            "name": "Test Buyer", "company": "Individual buyer", "phone": "+91 9000011111", "consent": True}
+    body.update(over)
+    r = client.post("/api/v1/leads", json=body)
+    assert r.status_code == 201, r.text
+    return r.json()["lead_id"]
+
+
+def chat_record(**over):
+    rec = {"lead_id": "chat-1", "client_id": "shree-heights", "name": "Asha Roy", "phone": "+919000022222",
+           "property_type": "flat", "timeline": "1_3", "budget_max_lakh": 80, "role": "researching",
+           "consult_type": None, "followup_consent": None, "stage": "In conversation", "score": "Warm",
+           "summary": "2 BHK, about 80 lakh", "open_questions": ["parking charges?"], "utm_source": "instagram"}
+    rec.update(over)
+    return rec
+
+
+def test_patch_updates_fields_and_audits(client):
+    lead_id = make_lead(client)
+    r = client.patch(f"/api/v1/leads/{lead_id}", headers=ADMIN,
+                     json={"stage": "qualified", "fit_score": 72, "fit_reasons": ["Pratha rubric"], "owner": "Pratha"})
+    assert r.status_code == 200
+    lead = r.json()
+    assert (lead["stage"], lead["fit_score"], lead["fit_reasons"], lead["owner"]) == ("qualified", 72, ["Pratha rubric"], "Pratha")
+    audit = client.get("/api/v1/audit", headers=ADMIN).json()
