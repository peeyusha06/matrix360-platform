+<body>
+<main>
+  <div class="bar" style="justify-content:space-between">
+    <h1>Matrix360 Leads</h1>
+    <div class="bar">
+      <label for="key" class="muted">Admin key</label>
+      <input id="key" type="password" autocomplete="off">
+      <select id="client"><option value="">All clients</option><option>Lakhotia</option><option>Shree Heights</option><option>Vrindavan Greens</option></select>
+      <button id="load" type="button">Load</button>
+    </div>
+  </div>
+  <p id="msg" class="muted">Enter the admin key and press Load. One list for every tool: Radar, landing pages, chat, WhatsApp, referrals.</p>
+  <section><h2>Funnel</h2><div id="funnel" class="funnel"></div></section>
+  <section class="wrap"><table>
+    <thead><tr><th>Lead</th><th>Client</th><th>Source</th><th>Stage</th><th>Intent</th><th>Fit</th><th>Consent</th><th>Next action</th><th>Updated</th></tr></thead>
+    <tbody id="rows"></tbody></table></section>
+  <section id="detail" hidden></section>
+</main>
+<script>
+const $ = (id) => document.getElementById(id);
+const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
+try { $("key").value = sessionStorage.getItem("m360key") || ""; } catch {}
+async function api(path) {
+  const r = await fetch(path, { headers: { "X-Admin-Key": $("key").value } });
+  if (!r.ok) throw new Error(r.status === 401 ? "Wrong admin key." : `Error ${r.status}`);
+  return r.json();
+}
+async function load() {
+  try { sessionStorage.setItem("m360key", $("key").value); } catch {}
+  try {
+    const q = $("client").value ? `&client=${encodeURIComponent($("client").value)}` : "";
+    const [funnel, leads] = await Promise.all([api("/api/v1/funnel"), api(`/api/v1/leads?limit=500${q}`)]);
+    $("msg").textContent = `${leads.length} lead(s). Click a row for its full history.`;
+    $("msg").className = "muted";
+    const tiles = { ...funnel.stages, total: funnel.total };
+    $("funnel").innerHTML = Object.entries(tiles).map(([k, v]) => `<div class="tile"><b>${v}</b><span>${esc(k.replace("_", " "))}</span></div>`).join("");
+    $("rows").innerHTML = leads.map((l) => `<tr class="row" data-id="${esc(l.lead_id)}">
+      <td><b>${esc(l.company !== "Individual buyer" ? l.company : l.name)}</b><br><span class="muted">${esc(l.name)} · ${esc(l.phone || "")}</span></td>
+      <td>${esc(l.client)}</td><td>${esc(l.source)}</td><td>${esc(l.stage)}</td>
+      <td><span class="pill ${esc(l.intent)}">${esc(l.intent)}</span></td><td>${l.fit_score}</td>
+      <td>${l.opted_out ? '<span class="pill hot">opted out</span>' : l.consent ? '<span class="pill yes">yes</span>' : '<span class="muted">no</span>'}</td>
+      <td>${esc(l.next_action || "")}</td><td class="muted">${esc((l.updated_at || "").slice(0, 16).replace("T", " "))}</td></tr>`).join("");
+    document.querySelectorAll("tr.row").forEach((tr) => tr.addEventListener("click", () => show(tr.dataset.id)));
+  } catch (e) { $("msg").textContent = e.message; $("msg").className = "err"; }
+}
+async function show(id) {
+  const [l, contacts] = await Promise.all([api(`/api/v1/leads/${id}`), api(`/api/v1/leads/${id}/contacts`)]);
+  const d = $("detail"); d.hidden = false;
+  d.innerHTML = `<h2>${esc(l.company !== "Individual buyer" ? l.company : l.name)} · ${esc(l.client)}</h2>
+    <div class="muted">Source: ${esc(l.source)} · Evidence: ${esc(l.evidence)} · UTM: ${esc(l.utm_source || "-")} / ${esc(l.utm_campaign || "-")}</div>
+    <div><b>Fit ${l.fit_score}/100</b><ul>${(l.fit_reasons || []).map((r) => `<li>${esc(r)}</li>`).join("")}</ul></div>
+    ${l.details && l.details.chat ? `<div><b>Chat summary</b><p>${esc(l.details.chat.summary || "")}</p>
+      ${(l.details.chat.open_questions || []).length ? `<p class="warm">Needs a person to answer: ${esc(l.details.chat.open_questions.join("; "))}</p>` : ""}</div>` : ""}
+    <div><b>Messages</b><ul>${contacts.map((c) => `<li>${esc(c.timestamp.slice(0, 16).replace("T", " "))} · ${esc(c.channel)} ${esc(c.direction)} · ${esc(c.status)} ${c.text ? "· " + esc(c.text.slice(0, 140)) : ""}</li>`).join("") || "<li class='muted'>None yet</li>"}</ul></div>
+    <div><b>Site visits</b><ul>${(l.site_visits || []).map((v) => `<li>${esc(v.status)} ${esc(v.scheduled_at || "")}</li>`).join("") || "<li class='muted'>None</li>"}</ul></div>
+    <div><b>Audit trail</b><ul>${(l.audit_history || []).map((e) => `<li>${esc(e.created_at.slice(0, 16).replace("T", " "))} · ${esc(e.event_type)} · ${esc(e.actor)}</li>`).join("")}</ul></div>`;
+  d.scrollIntoView({ behavior: "smooth" });
+}
+$("load").addEventListener("click", load);
+$("key").addEventListener("keydown", (e) => { if (e.key === "Enter") load(); });
+</script>
+</body>
+</html>
